# Copy this file to ".env" and fill in your own values.  NEVER commit ".env".
# A platform with missing credentials is reported as "failed" in the API
# response; it does not stop the other platforms from posting.

# --- General ---------------------------------------------------------------
PLATFORM_TIMEOUT_SECONDS=20

# --- Telegraph (telegra.ph) - token OPTIONAL (an account is auto-created) ---
TELEGRAPH_ACCESS_TOKEN=

# --- Write.as - token OPTIONAL (anonymous posts work without it) ------------
WRITEAS_ACCESS_TOKEN=

# --- Mastodon: Preferences > Development > New application (write:statuses) -
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# --- Bluesky: Settings > Privacy and security > App passwords ---------------
BLUESKY_SERVICE_URL=https://bsky.social
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=

# --- DEV Community: Settings > Extensions > "Generate API key" --------------
DEVTO_API_KEY=

# --- Telegram: create a bot with @BotFather, create a PUBLIC channel and ----
# --- add the bot as an admin with permission to post messages ---------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@your_public_channel